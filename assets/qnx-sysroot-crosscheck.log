# Cross-check: every system header the example includes, looked up in the real QNX SDP 8.0 target sysroot,
# next to the qport findings for those headers (with --show-guarded so code inside #ifdef __linux__ is listed too).

$ for h in $(grep -ho "#include <[^>]*>" examples/linux-telemetryd/src/*.c | sed "s/#include <\(.*\)>/\1/" | sort -u); do if test -f "$QNX_TARGET/usr/include/$h"; then echo "present  $h"; else echo "MISSING  $h"; fi; done
present  errno.h
